{
  "name": "art-archive-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "artvee:ingest": "node scripts/artvee-ingest.mjs",
    "artvee:publish-reviewed": "node scripts/artvee-publish-reviewed.mjs",
    "museum:ingest": "node scripts/museum-api-ingest.mjs",
    "db:ingest:artvee": "npm run artvee:ingest",
    "check": "node scripts/check-project-entry.mjs && node scripts/check.mjs",
    "check:entry": "node scripts/check-project-entry.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint \"src/**/*.{js,ts}\" \"miniapp/**/*.{js,mjs,cjs}\" \"scripts/**/*.{js,mjs,cjs}\" \"tests/**/*.{js,mjs,cjs,ts}\" \"*.config.{js,ts}\"",
    "format": "prettier --write README.md CHANGELOG.md package.json \".github/workflows/*.yml\" \"*.config.{js,ts}\" \"src/**/*.{js,ts}\" \"miniapp/**/*.{js,mjs,cjs,json}\" \"scripts/**/*.{js,mjs,cjs}\" \"tests/**/*.{js,mjs,cjs,ts}\" --ignore-unknown --ignore-path .gitignore",
    "format:check": "prettier --check README.md CHANGELOG.md package.json \".github/workflows/*.yml\" \"*.config.{js,ts}\" \"src/**/*.{js,ts}\" \"miniapp/**/*.{js,mjs,cjs,json}\" \"scripts/**/*.{js,mjs,cjs}\" \"tests/**/*.{js,mjs,cjs,ts}\" --ignore-unknown --ignore-path .gitignore",
    "check:syntax": "node scripts/check-active-js-syntax.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:artvee": "node --test scripts/artvee-ingest.test.mjs scripts/artvee-publish-reviewed.test.mjs",
    "test:museum": "node --test scripts/museum-api-ingest.test.mjs",
    "test:entry": "node --test scripts/check-project-entry.test.mjs",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:images": "node --test scripts/image-derivatives.test.mjs",
    "test:cos": "node --test scripts/cos-sdk-v3-smoke.test.mjs",
    "test:ci": "node --test scripts/ci-workflows.test.mjs scripts/ci/validate-release-gate.test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "images:manifest": "node scripts/generate-image-derivatives-manifest.mjs",
    "images:process": "node scripts/process-image-derivatives-manifest.mjs",
    "images:apply": "node scripts/apply-image-url-manifest.mjs",
    "cos:migrate-images": "node scripts/migrate-images-to-tencent-cos.mjs",
    "cos:migrate-db-urls": "node scripts/migrate-supabase-image-urls-to-cos.mjs",
    "cos:derivatives": "node scripts/generate-upload-cos-derivatives.mjs",
    "cos:smoke": "node scripts/cos-sdk-v3-smoke.mjs",
    "cloudbase:from-csv": "node scripts/cloudbase-docs-from-csv.mjs",
    "cloudbase:upload": "node scripts/cloudbase-upsert-artworks.mjs",
    "cloudbase:optimize-images": "node scripts/cloudbase-optimize-image-urls.mjs",
    "cloudbase:audit": "node scripts/cloudbase-audit-artworks.mjs",
    "cloudbase:account:plan": "node scripts/cloudbase/deploy-account-foundation.mjs",
    "cloudbase:account:deploy": "node scripts/cloudbase/deploy-account-foundation.mjs --run",
    "cloudbase:achievements:migrate:plan": "node scripts/cloudbase/migrate-achievement-accounts.mjs --allow-production",
    "cloudbase:achievements:migrate": "node scripts/cloudbase/migrate-achievement-accounts.mjs --allow-production --run",
    "cloudbase:search:plan": "node scripts/cloudbase/deploy-artwork-search.mjs",
    "cloudbase:search:deploy": "node scripts/cloudbase/deploy-artwork-search.mjs --run",
    "recommendation:release": "node scripts/data-governance/prepare-recommendation-release-v1.mjs",
    "recommendation:audit": "node scripts/data-governance/audit-recommendation-production-v1.mjs",
    "recommendation:smoke": "node scripts/data-governance/smoke-recommendation-queries-v1.mjs",
    "recommendation:devtools-smoke": "node scripts/data-governance/smoke-wechat-devtools-recommendation-v1.mjs",
    "cloudbase:recommendation:plan": "node scripts/data-governance/deploy-recommendation-system-v1.mjs --full",
    "cloudbase:recommendation:pilot": "node scripts/data-governance/deploy-recommendation-system-v1.mjs --run --pilot",
    "test:account": "node --test miniapp/cloudfunctions/accountProfile/account-profile.test.mjs miniapp/cloudfunctions/accountProfile/achievement-catalog.test.mjs miniapp/cloudfunctions/accountProfile/achievement-store.test.mjs miniapp/cloudfunctions/accountProfile/achievement-engine.test.mjs miniapp/cloudfunctions/accountProfile/achievement-state.test.mjs miniapp/cloudfunctions/accountProfile/library-sync.test.mjs miniapp/services/account.test.mjs miniapp/services/local-library.test.mjs miniapp/services/library-sync-state.test.mjs miniapp/services/user-library-sync.test.mjs miniapp/pages/achievements/achievements.test.mjs miniapp/pages/profile/profile.test.mjs miniapp/pages/profile-edit/profile-edit.test.mjs miniapp/pages/privacy/privacy.test.mjs miniapp/pages/account-data/account-data.test.mjs miniapp/pages/help/help.test.mjs miniapp/pages/about/about.test.mjs miniapp/pages/legal/legal.test.mjs scripts/cloudbase/deploy-account-foundation.test.mjs scripts/cloudbase/migrate-achievement-accounts.test.mjs",
    "verify": "npm run check && npm run typecheck && npm run lint && npm run format:check && npm run check:syntax && npm run test:unit && npm run test:node && npm run test:e2e && npm run build",
    "ci:pr": "npm run audit:production && npm run verify",
    "release:validate": "node scripts/ci/validate-release-gate.mjs",
    "test:rbac": "git diff --quiet -- supabase && node -e \"console.log('RBAC SQL unchanged.')\"",
    "test:permissions": "git diff --quiet -- supabase && node -e \"console.log('Supabase permission SQL unchanged.')\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "dexie": "^4.4.2",
    "minisearch": "^7.2.0",
    "openseadragon": "^6.0.2",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "^5.6.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "miniprogram-automator": "^0.12.1",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
