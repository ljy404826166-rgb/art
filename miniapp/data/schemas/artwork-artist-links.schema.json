{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://art-archive.local/schemas/artwork-artist-links.schema.json",
  "title": "ArtworkArtistLink",
  "type": "object",
  "required": ["_id", "artwork_id", "artist_id", "role", "review_status"],
  "additionalProperties": true,
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "artwork_id": {
      "type": "string",
      "minLength": 1
    },
    "artist_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "creator",
        "after",
        "attributed_to",
        "workshop",
        "publisher",
        "subject",
        "unknown"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": ["candidate", "reviewed", "rejected"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "accessed_at": { "type": "string" }
        }
      }
    }
  }
}
