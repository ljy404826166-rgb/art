{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://art-archive.local/schemas/vocab-terms.schema.json",
  "title": "VocabularyTerm",
  "type": "object",
  "required": ["_id", "type", "label_zh", "review_status"],
  "additionalProperties": true,
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "style",
        "subject",
        "medium",
        "period",
        "region",
        "country",
        "collection",
        "source"
      ]
    },
    "label_zh": {
      "type": "string",
      "minLength": 1
    },
    "label_en": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review_status": {
      "type": "string",
      "enum": ["candidate", "reviewed", "rejected"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "accessed_at": { "type": "string" }
        }
      }
    }
  }
}
