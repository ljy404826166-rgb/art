.artist-portrait-shell {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #5b3129;
  background: linear-gradient(135deg, #f4eee8, #ded5cc);
  font-weight: 900;
}

.artist-portrait-shell.list {
  width: 118rpx;
  height: 118rpx;
  font-size: 38rpx;
}

.artist-portrait-shell.detail {
  width: 168rpx;
  height: 168rpx;
  font-size: 58rpx;
  font-weight: 950;
}

.artist-portrait-shell.followed {
  width: 92rpx;
  height: 92rpx;
  font-size: 36rpx;
  font-weight: 950;
}

.artist-portrait-image {
  display: block;
  width: 100%;
  height: 100%;
}

.artist-portrait-image.is-loading {
  opacity: 0;
}

.artist-portrait-loading {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(90deg, #eee7df 0%, #f7f3ef 50%, #e5ddd5 100%);
}

.artist-portrait-fallback {
  display: block;
  max-width: 80%;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
