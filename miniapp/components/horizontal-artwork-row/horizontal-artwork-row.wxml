<view class="artwork-row-area">
  <scroll-view
    class="artwork-row-scroll"
    scroll-x="true"
    enhanced="true"
    show-scrollbar="false"
    scroll-left="{{scrollLeft}}"
    lower-threshold="120"
    bindscrolltolower="handleRowToLower"
  >
    <view class="artwork-row-track">
      <block wx:for="{{items}}" wx:key="id">
        <view class="artwork-row-item">
          <artwork-card
            artwork="{{item}}"
            variant="row"
            data-index="{{index}}"
            bindtapcard="handleTapCard"
          />
        </view>
      </block>
      <view wx:if="{{loadingMore}}" class="artwork-row-status">
        <text class="artwork-row-status-text">加载中...</text>
      </view>
    </view>
  </scroll-view>
</view>
