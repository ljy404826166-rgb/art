.artwork-row-area {
  width: 100%;
  height: 568rpx;
  overflow: visible;
}

.artwork-row-scroll {
  width: 100%;
  height: 568rpx;
  white-space: nowrap;
}

.artwork-row-track {
  display: inline-flex;
  align-items: flex-start;
  gap: 28rpx;
  width: max-content;
  min-width: 100%;
  padding: 8rpx 72rpx 56rpx 40rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.artwork-row-item {
  display: block;
  flex: 0 0 auto;
  padding-bottom: 0;
  white-space: normal;
}

.artwork-row-status {
  display: flex;
  flex: 0 0 136rpx;
  height: 478rpx;
  align-items: center;
  justify-content: center;
  color: #8a8178;
  font-size: 24rpx;
  line-height: 32rpx;
}

.artwork-row-status-text {
  display: block;
  writing-mode: vertical-rl;
}
