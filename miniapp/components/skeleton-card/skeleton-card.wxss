.skeleton-list {
  display: grid;
  gap: 28rpx;
  padding: 0 34rpx;
}

.skeleton-list.grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.skeleton-list.row {
  display: flex;
  overflow: hidden;
  padding: 8rpx 28rpx 32rpx;
}

.skeleton-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(30, 24, 18, 0.08);
}

.skeleton-list.row .skeleton-card {
  flex: 0 0 330rpx;
  margin-right: 28rpx;
}

.skeleton-image {
  height: 340rpx;
  background: linear-gradient(90deg, #eeeae4 0%, #f7f5f2 50%, #eeeae4 100%);
}

.skeleton-list.row .skeleton-image {
  height: 350rpx;
}

.skeleton-copy {
  display: grid;
  gap: 12rpx;
  padding: 20rpx 22rpx 22rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
  background: #eeeae4;
}

.skeleton-line.title {
  width: 78%;
}

.skeleton-line.meta {
  width: 58%;
}
