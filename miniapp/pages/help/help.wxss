.help-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 34rpx calc(70rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.help-page button::after {
  border: 0;
}

.intro {
  display: grid;
  gap: 8rpx;
  padding: 12rpx 4rpx 34rpx;
}

.intro-kicker {
  color: #8b8079;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  line-height: 28rpx;
}

.intro-title {
  color: #111111;
  font-size: 52rpx;
  font-weight: 950;
  letter-spacing: -0.03em;
  line-height: 64rpx;
}

.intro-copy,
.contact-description,
.contact-footnote {
  color: #6f635d;
  font-size: 23rpx;
  line-height: 36rpx;
}

.section {
  display: grid;
  gap: 32rpx;
  margin: 0 6rpx;
}

.section-title {
  color: #111111;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.faq-list {
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.faq-item {
  border-bottom: 1rpx solid #eeeeee;
}

.faq-item:last-child {
  border-bottom: 0;
}

.faq-button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  align-items: center;
  justify-content: flex-start;
  margin: 0;
  border-radius: 0;
  padding: 40rpx 48rpx;
  color: #1a1c1c;
  background: #ffffff;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: left;
}

.faq-button--pressed {
  background: #f3f3f3;
}

.faq-question {
  flex: 1;
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: flex-start;
  margin-right: auto;
  font-weight: 600;
  text-align: left;
  white-space: nowrap;
}

.faq-toggle {
  flex: 0 0 48rpx;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
  color: #bbcbba;
}

.faq-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #bbcbba;
  border-bottom: 4rpx solid #bbcbba;
  transform: translateY(-4rpx) rotate(45deg);
  transform-origin: center;
}

.faq-toggle.is-expanded .faq-chevron {
  transform: translateY(4rpx) rotate(-135deg);
}

.faq-answer {
  padding: 0 48rpx 40rpx;
  color: #3d4a3d;
  font-size: 30rpx;
  line-height: 44rpx;
}

.contact-card {
  display: grid;
  justify-items: start;
  gap: 14rpx;
  margin-top: 34rpx;
  border-radius: 30rpx;
  padding: 30rpx;
  background: #111111;
}

.contact-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
  filter: invert(1);
}

.contact-copy {
  display: grid;
  gap: 6rpx;
}

.contact-title {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 42rpx;
}

.contact-description {
  color: #d6d1cc;
}

.contact-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0 0;
  border-radius: 999rpx;
  padding: 0 30rpx;
  color: #111111;
  background: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.contact-button:active {
  opacity: 0.86;
}

.contact-footnote {
  display: block;
  margin: 22rpx 8rpx 0;
  color: #8b8079;
  font-size: 20rpx;
  line-height: 32rpx;
}

@media (prefers-reduced-motion: reduce) {
  .faq-button,
  .contact-button {
    transition: none;
  }
}
