.profile-page {
  min-height: 100vh;
  padding: 32rpx 40rpx 176rpx;
  color: #1a1c1c;
  background: #f9f9f9;
}

.profile-page button::after {
  border: 0;
}

.profile-hero {
  position: relative;
  display: flex;
  gap: 32rpx;
  align-items: center;
  overflow: hidden;
  border-radius: 48rpx;
  padding: 48rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.profile-hero.is-loading {
  background: #f3f3f3;
}

.avatar {
  display: flex;
  box-sizing: border-box;
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 160rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #e8e8e8;
  border-radius: 999rpx;
  color: #5b3129;
  background: linear-gradient(135deg, #f4eee8, #ded5cc);
  font-size: 48rpx;
  font-weight: 800;
}

.avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-copy {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-width: 0;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
}

.profile-title-link {
  display: inline-flex;
  box-sizing: border-box;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  min-height: 40rpx;
  align-items: center;
  justify-content: flex-start;
  align-self: flex-start;
  margin: 0;
  border: 0;
  padding: 0;
  color: inherit;
  background: transparent;
  text-align: left;
}

.profile-title-hover {
  opacity: 0.72;
}

.profile-kicker {
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  color: #686460;
  background: rgba(232, 225, 220, 0.5);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
}

.profile-kicker-text {
  display: block;
  line-height: 32rpx;
}

.profile-kicker.is-earned {
  color: #07c160;
  background: #e7f8ed;
}

.profile-name {
  display: block;
  overflow: hidden;
  color: #1a1c1c;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-role {
  color: #3d4a3d;
  font-size: 24rpx;
  line-height: 36rpx;
}

.profile-state {
  position: absolute;
  top: 50%;
  right: 48rpx;
  display: grid;
  justify-items: end;
  gap: 8rpx;
  transform: translateY(-50%);
}

.profile-state-label {
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  color: #686460;
  background: rgba(232, 225, 220, 0.5);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
  white-space: nowrap;
}

.profile-retry {
  display: flex;
  min-width: 96rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 999rpx;
  padding: 0 20rpx;
  color: #ffffff;
  background: #1a1c1c;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.profile-retry[disabled] {
  opacity: 0.48;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 48rpx;
}

.stat-card {
  display: grid;
  min-height: 160rpx;
  align-content: center;
  justify-items: center;
  border-radius: 48rpx;
  padding: 32rpx 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.stat-card:active {
  transform: scale(0.98);
  opacity: 0.78;
}

.stat-value {
  color: #1a1c1c;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.stat-label {
  margin-top: 8rpx;
  color: #625e5a;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
  white-space: nowrap;
}

.menu-sections {
  display: grid;
  gap: 48rpx;
  margin-top: 48rpx;
}

.menu-section {
  display: grid;
  gap: 24rpx;
}

.menu-title {
  margin-left: 16rpx;
  color: #3d4a3d;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.menu-card {
  overflow: hidden;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.menu-row {
  position: relative;
  display: flex;
  min-height: 108rpx;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}

.menu-row::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1rpx;
  background: rgba(187, 203, 186, 0.1);
  content: "";
}

.menu-row:last-child::after {
  display: none;
}

.menu-copy {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  display: block;
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
}

.menu-row:active {
  transform: scale(0.98);
  background: #f3f3f3;
}

.menu-row.is-disabled {
  background: #f3f3f3;
  opacity: 0.58;
}

.menu-label {
  color: #1a1c1c;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.menu-arrow {
  display: block;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.56;
}

.menu-status {
  color: #686460;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .stat-card,
  .menu-row,
  .profile-title-link {
    transition: none;
  }
}
