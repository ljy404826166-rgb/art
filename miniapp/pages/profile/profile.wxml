<view class="profile-page">
  <view class="profile-hero {{user.loading ? 'is-loading' : ''}}">
    <view class="avatar">
      <image
        wx:if="{{user.avatarUrl}}"
        class="avatar-image"
        src="{{user.avatarUrl}}"
        mode="aspectFill"
      />
      <text wx:else>{{user.avatarText}}</text>
    </view>
    <view class="profile-copy">
      <view
        class="profile-title-link profile-kicker {{user.isDefaultAchievementTitle ? 'is-default' : 'is-earned'}}"
        aria-label="当前佩戴头衔：{{user.achievementTitle}}，查看我的成就"
        aria-role="button"
        bindtap="openAchievements"
        hover-class="profile-title-hover"
      >
        <text class="profile-kicker-text">{{user.achievementTitle}}</text>
      </view>
      <text class="profile-name">{{user.name}}</text>
      <text wx:if="{{user.role}}" class="profile-role">{{user.role}}</text>
    </view>
    <view class="profile-state">
      <text class="profile-state-label">{{user.statusLabel}}</text>
      <button
        wx:if="{{user.showRetry}}"
        class="profile-retry"
        disabled="{{user.loading}}"
        bindtap="retryAccount"
      >
        重试
      </button>
    </view>
  </view>

  <view class="stats-grid">
    <block wx:for="{{stats}}" wx:key="label">
      <view class="stat-card" data-route="{{item.route}}" bindtap="openStat">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </block>
  </view>

  <view class="menu-sections">
    <block wx:for="{{sections}}" wx:key="title">
      <view class="menu-section">
        <text class="menu-title">{{item.title}}</text>
        <view class="menu-card">
          <block wx:for="{{item.items}}" wx:key="label" wx:for-item="menuItem">
            <view
              class="menu-row {{menuItem.disabled ? 'is-disabled' : ''}}"
              data-route="{{menuItem.route}}"
              data-disabled="{{menuItem.disabled}}"
              bindtap="openMenuItem"
            >
              <view class="menu-copy">
                <image class="menu-icon" src="{{menuItem.icon}}" mode="aspectFit" />
                <text class="menu-label">{{menuItem.label}}</text>
              </view>
              <text wx:if="{{menuItem.disabled}}" class="menu-status">{{menuItem.status}}</text>
              <image
                wx:else
                class="menu-arrow"
                src="/assets/icons/lucide/svg/chevron-right.svg"
                mode="aspectFit"
              />
            </view>
          </block>
        </view>
      </view>
    </block>
  </view>
</view>
