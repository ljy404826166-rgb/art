.about-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 48rpx calc(96rpx + env(safe-area-inset-bottom));
  color: #333333;
  background: #f9f9f9;
}

.brand {
  display: grid;
  justify-items: center;
  margin-bottom: 64rpx;
  text-align: center;
}

.brand-name {
  color: #333333;
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 80rpx;
}

.brand-tagline {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.mission-card {
  display: grid;
  margin-bottom: 80rpx;
  border-radius: 32rpx;
  padding: 48rpx;
  color: #ffffff;
  background: #18181b;
  box-shadow: 0 20rpx 30rpx rgba(0, 0, 0, 0.14);
}

.mission-title {
  margin-bottom: 48rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.mission-copy {
  color: #d1d5db;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.section-divider {
  height: 1rpx;
  margin-bottom: 32rpx;
  background: #f3f4f6;
}

.legal-section {
  margin-bottom: 64rpx;
}

.legal-list {
  overflow: hidden;
  border: 1rpx solid #e8e5e1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.legal-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  box-sizing: border-box;
  padding: 0 24rpx 0 30rpx;
  border-bottom: 1rpx solid #eeeae6;
  background: #ffffff;
}

.legal-row:last-child {
  border-bottom: 0;
}

.legal-row--pressed {
  background: #f3f2ef;
}

.legal-title {
  min-width: 0;
  flex: 1;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.legal-arrow {
  display: block;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 auto;
  opacity: 0.55;
}

.contact-card {
  display: grid;
  margin-bottom: 64rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 16rpx;
  padding: 40rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.contact-title {
  margin-bottom: 24rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.contact-copy,
.contact-email {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.contact-copy {
  color: #6b7280;
}

.contact-email {
  color: #07c160;
  font-weight: 500;
}

.about-footer {
  padding: 0 32rpx;
  color: #9ca3af;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .legal-row {
    transition: none;
  }
}
