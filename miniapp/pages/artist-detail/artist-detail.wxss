.artist-detail-page {
  min-height: 100vh;
  padding: 34rpx 34rpx 150rpx;
  background: #ffffff;
}

.artist-detail-page button::after {
  border: 0;
}

.artist-hero {
  display: grid;
  justify-items: center;
  text-align: center;
}

.portrait {
  display: flex;
  width: 168rpx;
  height: 168rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #5b3129;
  background: linear-gradient(135deg, #f4eee8, #ded5cc);
  font-size: 58rpx;
  font-weight: 950;
}

.artist-name {
  margin-top: 26rpx;
  color: #111111;
  font-size: 48rpx;
  font-weight: 950;
  line-height: 60rpx;
}

.artist-en,
.artist-life {
  color: #6f635d;
  font-size: 26rpx;
  line-height: 38rpx;
}

.follow-button {
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  border: 1rpx solid #e7e1dc;
  border-radius: 999rpx;
  padding: 0 28rpx;
  color: #2f2b28;
  background: #ffffff;
  font-size: 25rpx;
  font-weight: 850;
  box-shadow: 0 10rpx 26rpx rgba(30, 28, 25, 0.05);
}

.follow-button.is-active {
  border-color: #171717;
  color: #111111;
  background: #f0ede9;
}

.follow-button:active {
  opacity: 0.72;
}

.follow-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.artist-bio {
  margin-top: 22rpx;
  color: #4f4944;
  font-size: 28rpx;
  line-height: 46rpx;
  text-align: left;
}

.info-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 34rpx;
}

.info-card {
  display: grid;
  gap: 10rpx;
  min-height: 132rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  padding: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(30, 28, 25, 0.05);
}

.info-label {
  display: block;
  color: #9a918a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.info-value {
  display: -webkit-box;
  overflow: hidden;
  color: #1f2328;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.artist-tag {
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  color: #5f5a55;
  background: #f2f0ed;
  font-size: 23rpx;
  font-weight: 800;
}

.works-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 44rpx 0 24rpx;
}

.section-title {
  color: #111111;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 50rpx;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 26rpx;
}

.artist-detail-skeleton {
  display: grid;
  gap: 28rpx;
}

.skeleton-hero {
  display: grid;
  justify-items: center;
  text-align: center;
}

.skeleton-portrait,
.skeleton-line,
.skeleton-pill,
.skeleton-bio-line,
.skeleton-info-card,
.skeleton-tag,
.skeleton-section-title,
.skeleton-work-card {
  background: linear-gradient(90deg, #f1ede8 0%, #e8e2dc 48%, #f4f1ed 100%);
}

.skeleton-portrait {
  width: 168rpx;
  height: 168rpx;
  border-radius: 999rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-name {
  width: 260rpx;
  height: 42rpx;
  margin-top: 28rpx;
}

.skeleton-en {
  width: 210rpx;
  margin-top: 18rpx;
}

.skeleton-life {
  width: 280rpx;
  margin-top: 12rpx;
}

.skeleton-pill {
  width: 176rpx;
  height: 58rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
}

.skeleton-bio-line {
  width: 100%;
  height: 28rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
}

.skeleton-bio-line.is-short {
  width: 72%;
  margin-top: 16rpx;
  justify-self: start;
}

.skeleton-info-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.skeleton-info-card {
  min-height: 132rpx;
  border-radius: 24rpx;
}

.skeleton-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.skeleton-tag {
  width: 112rpx;
  height: 46rpx;
  border-radius: 999rpx;
}

.skeleton-works-head {
  margin-top: 8rpx;
}

.skeleton-section-title {
  width: 168rpx;
  height: 44rpx;
  border-radius: 999rpx;
}

.skeleton-works-grid,
.works-grid-skeleton {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 26rpx;
}

.skeleton-work-card {
  height: 330rpx;
  border-radius: 24rpx;
}

.detail-notice {
  margin-top: 26rpx;
}
