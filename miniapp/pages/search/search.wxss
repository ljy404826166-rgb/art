.search-page {
  min-height: 100vh;
  padding: 34rpx 34rpx 148rpx;
  background: #faf9f7;
}

.search-page button::after {
  border: 0;
}

.search-shell {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  border-radius: 999rpx;
  padding: 0 22rpx 0 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 54rpx rgba(25, 25, 25, 0.06);
}

.search-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.search-input {
  min-width: 0;
  height: 88rpx;
  color: #242424;
  font-size: 31rpx;
  line-height: 88rpx;
}

.search-placeholder {
  color: #bdb7b1;
}

.clear-button {
  display: flex;
  min-width: 78rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 0 18rpx;
  color: #5f5a55;
  background: #efede9;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 56rpx;
}

.search-intro {
  display: grid;
  gap: 14rpx;
  margin-top: 46rpx;
  border-radius: 30rpx;
  padding: 34rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(30, 28, 25, 0.04);
}

.intro-title {
  color: #111111;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 52rpx;
}

.intro-copy {
  color: #706860;
  font-size: 27rpx;
  line-height: 44rpx;
}

.result-section {
  margin-top: 38rpx;
}

.result-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.result-title {
  color: #111111;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 52rpx;
}

.result-count {
  color: #7a736d;
  font-size: 24rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx;
  align-items: start;
}
