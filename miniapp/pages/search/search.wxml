<view class="search-page">
  <view class="search-shell">
    <image class="search-icon" src="/assets/icons/lucide/svg/search.svg" mode="aspectFit" />
    <input
      class="search-input"
      value="{{query}}"
      placeholder="搜索画作、艺术家、标签..."
      placeholder-class="search-placeholder"
      confirm-type="search"
      focus="{{true}}"
      bindinput="handleInput"
      bindconfirm="handleConfirm"
    />
    <button wx:if="{{query}}" class="clear-button" bindtap="clearSearch">清除</button>
  </view>

  <error-state
    wx:if="{{error}}"
    title="搜索读取失败"
    message="{{usingFallback ? '已显示本地备用搜索结果。' : error}}"
    bindretry="retrySearch"
  />

  <view wx:if="{{!searched && !loading}}" class="search-intro">
    <text class="intro-title">全库搜索</text>
    <text class="intro-copy">可按作品名、艺术家、流派、题材、媒介、年代或地点查找作品。</text>
  </view>

  <skeleton-card wx:elif="{{loading}}" variant="grid" count="{{4}}" />

  <view wx:else class="result-section">
    <view class="result-head">
      <text class="result-title">搜索结果</text>
      <text class="result-count">已显示{{artworks.length}}件作品</text>
    </view>

    <empty-state
      wx:if="{{artworks.length === 0}}"
      icon="/assets/icons/lucide/svg/search-x.svg"
      title="没有找到匹配作品"
      description="换一个画作、艺术家或标签试试。"
      show-action="{{false}}"
    />

    <view wx:else class="result-grid">
      <block wx:for="{{artworks}}" wx:key="id">
        <artwork-card artwork="{{item}}" bindtapcard="openDetail" />
      </block>
    </view>

    <loading-more wx:if="{{loadingMore}}" text="继续搜索..." />
    <loading-more wx:elif="{{!hasMore && artworks.length}}" text="已显示当前搜索结果" done="{{true}}" />
  </view>
</view>
