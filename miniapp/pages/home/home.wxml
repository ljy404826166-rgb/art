<view class="page home-page">
  <view class="search-shell">
    <view class="search-icon" aria-label="search">
      <image class="search-glyph" src="/assets/icons/lucide/svg/search.svg" mode="aspectFit" />
    </view>
    <input
      class="search-input"
      value="{{searchQuery}}"
      placeholder="{{searchPlaceholder}}"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindconfirm="submitSearch"
      bindinput="handleSearchInput"
    />
    <view
      wx:if="{{searchMode}}"
      class="search-action submit-search-action"
      aria-role="button"
      bindtap="submitSearch"
    >
      搜索
    </view>
    <view wx:else class="search-action filter-action" bindtap="openCategory" aria-label="筛选分类">
      <image class="filter-glyph" src="/assets/icons/lucide/svg/sliders-horizontal.svg" mode="aspectFit" />
    </view>
  </view>

  <error-state
    wx:if="{{error}}"
    title="云数据库暂不可用"
    message="{{usingFallback ? '已显示本地备用作品。' : error}}"
    bindretry="retryLoad"
  />

  <view wx:if="{{loading}}" class="home-skeleton-feed">
    <view class="home-skeleton-group">
      <view class="home-skeleton-head">
        <view class="home-skeleton-title"></view>
      </view>
      <scroll-view class="home-skeleton-row" scroll-x="true" enable-flex="true" show-scrollbar="false">
        <view class="home-skeleton-track">
          <view class="home-skeleton-card compact"></view>
          <view class="home-skeleton-card wide"></view>
          <view class="home-skeleton-card compact"></view>
        </view>
      </scroll-view>
    </view>

    <view class="home-skeleton-group">
      <view class="home-skeleton-head">
        <view class="home-skeleton-title short"></view>
      </view>
      <scroll-view class="home-skeleton-row" scroll-x="true" enable-flex="true" show-scrollbar="false">
        <view class="home-skeleton-track">
          <view class="home-skeleton-card compact"></view>
          <view class="home-skeleton-card compact"></view>
          <view class="home-skeleton-card wide"></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:elif="{{searchMode}}" class="recommendation-feed">
    <view class="recommendation-group">
      <view class="recommendation-group-head">
        <text class="group-title">搜索结果</text>
      </view>

      <view
        wx:if="{{searchLoading}}"
        class="home-brand-loader search-brand-loader"
        aria-label="正在搜索作品"
      >
        <image
          class="home-brand-loader-image"
          src="/assets/brand/masterpiece-loading.gif"
          mode="aspectFit"
        />
      </view>

      <empty-state wx:elif="{{searchResults.length === 0}}" icon="/assets/icons/lucide/svg/search-x.svg" title="没有找到匹配作品" description="换一个画作、艺术家或标签试试。" />

      <view wx:else class="search-results-grid">
        <block wx:for="{{searchResults}}" wx:key="id">
          <artwork-card artwork="{{item}}" bindtapcard="openDetail" />
        </block>
      </view>

      <view
        wx:if="{{searchLoadingMore}}"
        class="home-brand-loader search-brand-loader search-brand-loader-more"
        aria-label="正在加载更多搜索结果"
      >
        <image
          class="home-brand-loader-image"
          src="/assets/brand/masterpiece-loading.gif"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>

  <view wx:else class="recommendation-feed">
    <block wx:for="{{sections}}" wx:key="key" wx:for-index="sectionIndex">
      <view class="recommendation-group">
        <view class="recommendation-group-head">
          <text class="group-title">{{item.title}}</text>
          <view
            wx:if="{{item.showMore}}"
            class="section-more"
            data-tag="{{item.targetTag}}"
            data-title="{{item.title}}"
            data-query-type="{{item.queryType}}"
            data-query-id="{{item.queryId}}"
            data-query-label="{{item.queryLabel}}"
            hover-class="section-more-hover"
            bindtap="openTagDetail"
          >
            <text class="section-more-text">查看更多</text>
            <image class="section-more-icon" src="/assets/icons/lucide/svg/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>

        <horizontal-artwork-row
          items="{{item.items}}"
          section-index="{{sectionIndex}}"
          loading-more="{{item.loadingMore}}"
          data-section-index="{{sectionIndex}}"
          bindtapcard="openDetail"
          bindrowtolower="handleSectionScrollToLower"
        />
      </view>
    </block>
    <view wx:if="{{loadingMore}}" class="home-brand-loader" aria-label="正在加载更多推荐">
      <image
        class="home-brand-loader-image"
        src="/assets/brand/masterpiece-loading.gif"
        mode="aspectFit"
      />
    </view>
  </view>
</view>
