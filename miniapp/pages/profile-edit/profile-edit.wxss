.profile-edit-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 30rpx calc(72rpx + env(safe-area-inset-bottom));
  background: #f8f8f7;
}

.profile-edit-page button::after {
  border: 0;
}

.intro {
  display: grid;
  gap: 6rpx;
  padding: 10rpx 0 36rpx;
}

.intro-kicker {
  color: #36434a;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.13em;
  line-height: 26rpx;
}

.intro-title {
  color: #0c151a;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 52rpx;
}

.intro-copy {
  margin-top: 4rpx;
  color: #6d777b;
  font-size: 22rpx;
  line-height: 34rpx;
}

.profile-form {
  position: relative;
  overflow: hidden;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.04);
}

.profile-form.is-loading {
  opacity: 0.68;
}

.field-group {
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.avatar-field {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding-top: 48rpx;
  padding-bottom: 64rpx;
}

.nickname-field {
  padding-top: 64rpx;
  padding-bottom: 48rpx;
}

.field-label {
  display: block;
  color: #1a1c1c;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field-divider {
  height: 1rpx;
  margin: 0 48rpx;
  background: rgba(187, 203, 186, 0.2);
}

.avatar-picker {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 192rpx;
  align-items: center;
  gap: 32rpx;
  margin: 32rpx 0 0;
  border-radius: 32rpx;
  padding: 32rpx;
  color: #1a1c1c;
  background: #f3f3f3;
  font-size: inherit;
  line-height: normal;
  text-align: left;
}

.avatar-picker:active {
  background: #e2e2e2;
}

.avatar-picker.is-disabled {
  opacity: 0.58;
}

.avatar-preview {
  display: flex;
  flex: 0 0 auto;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
  color: #5b3129;
  background: linear-gradient(135deg, #f4eee8, #ded5cc);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 34rpx;
  font-weight: 950;
}

.avatar-action-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.avatar-action-title {
  color: #1a1c1c;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
  white-space: nowrap;
}

.avatar-action-arrow {
  flex: 0 0 auto;
  margin-left: auto;
  color: #bbcbba;
  font-size: 48rpx;
  line-height: 48rpx;
}

.avatar-picker-hitbox {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  border-radius: 32rpx;
  padding: 0;
  opacity: 0;
}

.nickname-control {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  margin-top: 32rpx;
  border-radius: 32rpx;
  background: #f3f3f3;
}

.nickname-input {
  display: block;
  flex: 1 1 0%;
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  min-height: 112rpx;
  padding: 0 96rpx 0 48rpx;
  color: #1a1c1c;
  background: transparent;
  font-size: 30rpx;
  font-weight: 400;
}

.nickname-input:focus {
  border-radius: 32rpx;
  box-shadow: inset 0 0 0 2rpx rgba(7, 193, 96, 0.2);
  background: #ffffff;
}

.nickname-placeholder {
  color: #8d989b;
}

.nickname-clear {
  position: absolute;
  z-index: 3;
  top: 50%;
  right: 18rpx;
  display: flex;
  flex: 0 0 52rpx;
  box-sizing: border-box;
  width: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 999rpx;
  padding: 0;
  transform: translateY(-50%);
}

.nickname-clear:active {
  background: #e9edeb;
}

.nickname-clear-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #aebbb8;
  border-radius: 999rpx;
  padding: 4rpx;
  opacity: 0.78;
}

.form-error {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: 12rpx;
  margin: 0 30rpx 30rpx;
  border-radius: 18rpx;
  padding: 10rpx 18rpx;
  color: #8f2f24;
  background: #fff3f1;
  font-size: 22rpx;
  line-height: 32rpx;
}

.form-error-icon {
  display: block;
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
}

@media (prefers-reduced-motion: reduce) {
  .avatar-picker,
  .nickname-clear {
    transition: none;
  }
}
