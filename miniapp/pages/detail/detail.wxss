.detail-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: #faf9f7;
}

.detail-loading,
.detail-error {
  margin: 32rpx;
}

.detail-skeleton {
  padding-top: 28rpx;
}

.detail-skeleton-hero {
  height: 834rpx;
  margin: 0 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #eeeae4 0%, #f7f5f2 50%, #eeeae4 100%);
  box-shadow: 0 18rpx 48rpx rgba(20, 20, 20, 0.06);
}

.detail-skeleton-body {
  display: grid;
  gap: 18rpx;
  padding: 42rpx 36rpx 0;
}

.detail-skeleton-line,
.detail-skeleton-pill,
.detail-skeleton-meta {
  border-radius: 999rpx;
  background: #eeeae4;
}

.eyebrow-line {
  width: 220rpx;
  height: 24rpx;
}

.title-line {
  width: 72%;
  height: 58rpx;
  margin-top: 4rpx;
}

.subtitle-line {
  width: 58%;
  height: 34rpx;
}

.detail-skeleton-pill {
  width: 540rpx;
  max-width: 86%;
  height: 58rpx;
  margin-top: 10rpx;
  background: #111111;
  opacity: 0.12;
}

.detail-skeleton-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 16rpx;
}

.detail-skeleton-meta {
  height: 132rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(30, 28, 25, 0.04);
}

.hero-image-wrap {
  overflow: hidden;
  margin: 28rpx 28rpx 0;
  border-radius: 32rpx;
  background: #171313;
  box-shadow: 0 24rpx 64rpx rgba(20, 20, 20, 0.12);
}

.detail-body {
  padding: 42rpx 36rpx 0;
}

.detail-title {
  display: block;
  margin-top: 12rpx;
  color: #141414;
  font-size: 58rpx;
  font-weight: 850;
  line-height: 72rpx;
}

.detail-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #332d2a;
  font-size: 32rpx;
  line-height: 44rpx;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.favorite-button {
  display: inline-flex;
  min-height: 56rpx;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid #e7e1dc;
  border-radius: 999rpx;
  padding: 0 24rpx;
  color: #2f2b28;
  background: #ffffff;
  font-size: 25rpx;
  font-weight: 850;
  box-shadow: 0 10rpx 26rpx rgba(30, 28, 25, 0.05);
}

.favorite-button.is-active {
  border-color: #171717;
  color: #111111;
  background: #f0ede9;
}

.favorite-button:active {
  opacity: 0.72;
}

.favorite-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.artist-line {
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  margin-top: 22rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  color: #ffffff;
  background: #111111;
  font-size: 26rpx;
  font-weight: 800;
}

.artist-line:active {
  opacity: 0.72;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 34rpx;
}

.meta-item {
  display: grid;
  gap: 8rpx;
  min-height: 132rpx;
  border-radius: 24rpx;
  padding: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(30, 28, 25, 0.05);
}

.meta-label {
  color: #9a918a;
  font-size: 23rpx;
  font-weight: 700;
}

.meta-value {
  display: -webkit-box;
  overflow: hidden;
  color: #26221f;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.description-card {
  display: grid;
  gap: 18rpx;
  margin-top: 30rpx;
  border-radius: 28rpx;
  padding: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(30, 28, 25, 0.05);
}

.description-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #141414;
  font-size: 30rpx;
  font-weight: 850;
}

.description-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
}

.detail-description {
  color: #4e4842;
  font-size: 30rpx;
  line-height: 52rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 30rpx;
}

.detail-tag {
  min-height: 54rpx;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  color: #5f5a55;
  background: #efede9;
  font-size: 24rpx;
  font-weight: 750;
}

.detail-tag:active {
  color: #ffffff;
  background: #202124;
}
