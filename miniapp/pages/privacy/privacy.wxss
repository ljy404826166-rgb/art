.privacy-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 34rpx calc(70rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.privacy-page button::after {
  border: 0;
}

.intro {
  display: grid;
  gap: 8rpx;
  padding: 12rpx 4rpx 34rpx;
}

.intro-kicker {
  color: #8b8079;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  line-height: 28rpx;
}

.intro-title {
  color: #111111;
  font-size: 52rpx;
  font-weight: 950;
  letter-spacing: -0.03em;
  line-height: 64rpx;
}

.intro-copy {
  color: #6f635d;
  font-size: 25rpx;
  line-height: 38rpx;
}

.official-card,
.data-list {
  overflow: hidden;
  border: 1rpx solid #eee9e4;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(31, 35, 40, 0.06);
}

.official-card {
  padding: 28rpx;
}

.official-heading {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.official-icon,
.data-icon {
  display: block;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
}

.official-copy,
.data-copy {
  display: grid;
  min-width: 0;
  flex: 1;
}

.official-title,
.data-title {
  color: #111111;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.official-hint,
.data-description,
.data-storage,
.boundary-card {
  color: #756b65;
  font-size: 22rpx;
  line-height: 34rpx;
}

.official-status {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  color: #6f635d;
  background: #f0ebe6;
  font-size: 20rpx;
  font-weight: 800;
}

.official-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 26rpx 0 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #111111;
  font-size: 26rpx;
  font-weight: 900;
}

.official-button[disabled] {
  opacity: 0.58;
}

.section {
  display: grid;
  gap: 16rpx;
  margin-top: 36rpx;
}

.section-title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 42rpx;
}

.data-card {
  display: flex;
  gap: 18rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid #eee9e4;
}

.data-card:last-child {
  border-bottom: 0;
}

.data-description {
  margin-top: 4rpx;
  color: #504944;
}

.data-storage {
  margin-top: 8rpx;
}

.boundary-card {
  display: grid;
  gap: 8rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  background: #fbfaf8;
}

.boundary-title {
  color: #111111;
  font-size: 25rpx;
  font-weight: 900;
}

@media (prefers-reduced-motion: reduce) {
  .official-button {
    transition: none;
  }
}
