.artists-page {
  min-height: 100vh;
  padding: 56rpx 0 158rpx;
  background: #ffffff;
}

.artists-page button::after {
  border: 0;
}

.search-shell {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  height: 88rpx;
  margin: 0 34rpx 34rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 54rpx rgba(25, 25, 25, 0.06);
}

.search-icon {
  display: flex;
  width: 48rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
}

.search-glyph {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.search-input {
  min-width: 0;
  height: 88rpx;
  color: #242424;
  font-size: 29rpx;
  line-height: 88rpx;
}

.search-placeholder {
  color: #b6b0aa;
}

.search-action {
  color: #1f2328;
  font-size: 24rpx;
  font-weight: 850;
}

.filter-panel {
  display: grid;
  gap: 30rpx;
}

.filter-section {
  display: grid;
  gap: 16rpx;
}

.filter-head {
  padding: 0 34rpx;
}

.filter-title {
  color: #101820;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.chip-scroll {
  width: 100%;
  height: 58rpx;
  white-space: nowrap;
}

.chip-track {
  display: inline-block;
  height: 58rpx;
  padding: 0 34rpx;
  white-space: nowrap;
}

.tag-chip {
  display: inline-flex;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  color: #777777;
  background: #f6f5f4;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 52rpx;
}

.tag-chip.is-active {
  color: #ffffff;
  background: #202124;
}

.tag-label {
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 44rpx 0 24rpx;
  padding: 0 34rpx;
}

.section-title {
  color: #000000;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 52rpx;
}

.result-count {
  color: #7a736d;
  font-size: 25rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.artist-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  padding: 0 34rpx;
}

.artist-card {
  display: grid;
  justify-items: center;
  min-width: 0;
  border-radius: 28rpx;
  padding: 30rpx 20rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(31, 35, 40, 0.06);
}

.artist-avatar {
  display: flex;
  width: 118rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #5b3129;
  background: linear-gradient(135deg, #f4eee8, #ded5cc);
  font-size: 38rpx;
  font-weight: 900;
}

.artist-copy {
  display: grid;
  justify-items: center;
  min-width: 0;
  margin-top: 18rpx;
}

.artist-name {
  max-width: 100%;
  overflow: hidden;
  color: #151515;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artist-en,
.artist-meta,
.artist-count {
  max-width: 100%;
  overflow: hidden;
  color: #77716b;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artist-count {
  margin-top: 8rpx;
  color: #8b5a3d;
  font-weight: 800;
}
