VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_never_commit_real_value

# Tencent Cloud COS migration. Prefer a temporary/sub-account key with COS-only permissions.
TENCENT_COS_BUCKET=your-bucket-1250000000
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PREFIX=artwork
TENCENT_COS_DOMAIN=https://your-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SESSION_TOKEN=

# Optional: trusted WeChat OPENIDs allowed to grant reviewed manual achievements.
# Leave empty to disable every manual grant operation.
ACHIEVEMENT_ADMIN_OPENIDS=

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

AIC_SYNC_PAGE_SIZE=12
AIC_SYNC_LIMIT=24
AIC_USER_AGENT=ArtArchive/0.1 your-email@example.com

# Optional: comma-separated Artvee artwork URLs to import.
# Keep Artvee imports low-frequency and verify each source page/license before publishing.
ARTVEE_URLS=https://artvee.com/example-artwork/

# Artvee ingestion script defaults.
ARTVEE_OUTPUT_DIR=D:\art\csv
ARTVEE_BUCKET=artwork
